# Block direct access to sensitive data files, database, and environment configs
<FilesMatch "\.(json|sqlite|sqlite3|db|env|csv|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
